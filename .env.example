# Copy to .env (git-ignored) and fill in ONE provider you use. Never commit real keys.
#   PowerShell:  Copy-Item .env.example .env ; notepad .env
#   bash:        cp .env.example .env
# Leave every value in THIS file empty — tests fail if .env.example contains a value.
# Check that git ignores your copy:  git check-ignore -v .env
# One session only, no file:  $env:GEMINI_API_KEY = "..."   (PowerShell)   export GEMINI_API_KEY=...   (bash)
# The tool redacts these values from every log line, but keep them out of screenshots too.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (free models: model "openrouter/free" or any id ending in ":free")
OPENROUTER_API_KEY=

# Anthropic — https://platform.claude.com  (paid API)
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint you control (set llm.base_url and llm.model in config/settings.yaml)
OPENAI_API_KEY=

# Ollama needs no key: install Ollama, `ollama pull <model>`, then run with --llm ollama --model <model>
